# Copy to .env and fill in. Every setting is documented in docs/configuration.md.

# Claude (used by the Claude Agent SDK)
ANTHROPIC_API_KEY=

# Jira Cloud
T2P_JIRA_BASE_URL=https://your-company.atlassian.net
T2P_JIRA_EMAIL=ticket2pr-bot@your-company.com
T2P_JIRA_API_TOKEN=
T2P_JIRA_WEBHOOK_SECRET=
T2P_TRIGGER_LABEL=ticket2pr

# GitHub: fine-grained token with Contents (read/write) + Pull requests (read/write)
T2P_GITHUB_TOKEN=
T2P_REPOS={"PROJ": "your-org/your-repo"}
T2P_BASE_BRANCH=main

# Agent limits
T2P_MODEL=claude-opus-5-5
T2P_EFFORT=high
T2P_MAX_BUDGET_USD=5
T2P_MAX_TURNS=80

# Optional: bearer token for GET /jobs (leave empty to disable the endpoint)
T2P_API_TOKEN=
